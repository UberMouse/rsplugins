.claude/worktrees/
dumps/
# Nix dev environment: direnv cache
.direnv/
__pycache__/
# Run state for sdd-loop / durable-state, and code-review reports
.durable-state/
# Symlink to the pinned API stubs, made by the flake shellHook
docs/api
# Var catalog, generated per checkout from a var dump (plugins/var-dump/README.md)
docs/vars/
# Copies of the pinned third-party dev plugins, made by the flake shellHook
plugins/debug-plugin
plugins/dev-kit
# Lock, temp and swapped-aside folders of that sync (plugins/.<name>.lock, .XXXXXX, .old.<pid>)
plugins/.debug-plugin.*
plugins/.dev-kit.*
# Engine type declarations copied into a mod by hand (.claude/skills/rsp-ops/README.md)
.claude/skills/*/.claude-plugin/types/
